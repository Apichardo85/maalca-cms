# MaalCaCMS Environment Variables Example
# Copy this file to .env and fill in your values
# WARNING: Never commit .env to version control!

# Database Configuration
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=MaalCaCMS
DB_USER=sa
DB_PASSWORD=YourStrong@Passw0rd

# Application Settings
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5011;https://localhost:7175

# Umbraco Configuration
UMBRACO_GLOBAL_ID=d8d0e7c9-9c6e-4f5a-9d8e-3f4c5b6a7b8c

# Docker Configuration
COMPOSE_PROJECT_NAME=maalcacms
MSSQL_SA_PASSWORD=YourStrong@Passw0rd
ACCEPT_EULA=Y
